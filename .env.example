# Copy this file to .env.local and replace every placeholder.
# Next.js loads .env.local automatically and does not load files from src/.
#
# Only NEXT_PUBLIC_ variables are sent to the browser.
# Never prefix service-role keys, PayPal secrets, or the Resend API key
# with NEXT_PUBLIC_.

# Public
# The theme editor and menu QR codes use these existing variables. They do not add any of their own.
# QR codes use NEXT_PUBLIC_APP_URL. In production that origin must be https and must not be a local host.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox
# Live orders stay off until this is the exact string true in production.
PAYPAL_LIVE_PAYMENTS=false
# Optional. The webhook route does nothing until this PayPal webhook id is set.
PAYPAL_WEBHOOK_ID=
RESEND_API_KEY=your-resend-api-key
# Sender address, for example Menor <billing@your-domain.com>. Mail is not sent while this is empty.
RESEND_FROM_EMAIL=
# Bearer secret for the daily reminder job. Use at least 16 characters. The route does nothing until this is set.
CRON_SECRET=
